FROM python:3.11-slim AS base

# Create non-root user
RUN groupadd --gid 1000 app && \
    useradd --uid 1000 --gid app --shell /bin/bash --create-home app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpcap-dev tshark libmagic1 \
    libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt gunicorn

# Copy application code
COPY --chown=app:app . .

# Collect static files as the app user
USER app
RUN ALLOWED_HOSTS="*" \
    DATABASE_URL="sqlite:///:memory:" \
    REDIS_URL="redis://localhost:6379/0" \
    SECRET_KEY="dummy-build-key" \
    python manage.py collectstatic --noinput --settings=cybersandbox.settings.production

# Create runtime directories
RUN mkdir -p logs media ml_models/saved_models ml_models/training_data && \
    chown -R app:app logs media ml_models

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/api/v1/health/', timeout=5)" || exit 1

CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "cybersandbox.asgi:application"]
